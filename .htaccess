# TechVantix — clean URLs & error handling
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Redirect any direct .html requests to their clean URL (except root files)
  RewriteCond %{THE_REQUEST} \s/([^\s]+)/index\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]
</IfModule>
